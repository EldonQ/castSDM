# castSDM configuration template --------------------------------------------
# All file paths are resolved relative to the directory containing this file.
# Every key under cast_batch_args is passed directly to cast_batch(); see
# ?cast_batch for the full argument list.

run:
  output_dir: castSDM_output
  seed: 42
  parallel: true
  resume: true

species:
  example_species:
    file: data/example_species.csv

# Optional shared prediction grid:
# env_data:
#   file: data/environment_grid.csv

models: [rf, brt, maxent, gam]

cast_batch_args:
  select_method: cpi        # cpi (default) | dml | rf
  select_min_vars: 3
  select_max_vars: 30
  select_num_trees: 300
  select_alpha: 0.05
  select_dml_folds: 5       # cross-fitting folds for cpi/dml
  select_cor_threshold: 0.8
  num_threads: 1
  do_cv: true
  cv_k: 5
  cv_block_method: grid
  do_predict: true
  do_ensemble: true
  ensemble_method: weighted # weighted | best | equal
  refit_full: true          # refit final models on the full data set
