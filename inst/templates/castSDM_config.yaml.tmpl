run:
  output_dir: castSDM_output
  seed: 42
  parallel: true
  resume: true

species:
  example_species:
    file: data/example_species.csv

# Optional shared prediction grid:
# env_data:
#   file: data/environment_grid.csv

models: [rf, brt, maxent, gam]

cast_batch_args:
  select_method: stable
  select_min_vars: 3
  select_max_vars: 12
  select_num_trees: 300
  do_cv: true
  cv_k: 5
  cv_block_method: grid
